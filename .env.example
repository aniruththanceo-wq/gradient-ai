# ==============================================================================
# GRADIENT AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `.env` in the root directory or configure these variables
# in your cloud deployment platform (Vercel, Render, Railway, Fly.io, etc.).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# Set to 'production' for live deployments.
# In 'production', dev-login bypass is disabled and secure cookie flags are enforced.
# Values: 'development' | 'production' | 'testing'
ENVIRONMENT=development

# Logging verbosity: 'DEBUG' | 'INFO' | 'WARNING' | 'ERROR'
LOG_LEVEL=INFO


# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL in Production)
# ------------------------------------------------------------------------------
# Local Development default (SQLite):
# DATABASE_URL=sqlite+pysqlite:///./gradient_ai_dev.db
#
# Production (Managed PostgreSQL: Neon, Supabase, Render, Railway, AWS RDS):
# Note: psycopg3 driver prefix `postgresql+psycopg://` is recommended.
# If `postgres://` is provided by your host, Gradient AI automatically normalizes it.
DATABASE_URL=postgresql+psycopg://postgres:your-db-password@your-db-host:5432/gradient_ai

# Set to 'false' in production if you prefer managing schema solely via Alembic migrations.
# Set to 'true' to ensure reference seed data (questions, problems, company profiles) initializes on startup.
AUTO_CREATE_TABLES=true


# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SESSION SECURITY
# ------------------------------------------------------------------------------
# REQUIRED IN PRODUCTION: A secure, high-entropy secret key (minimum 32 characters).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace-with-a-random-32-char-secret-for-production-use

# Session cookie name
SESSION_COOKIE_NAME=gradient_ai_session

# Session expiry duration in minutes (10080 = 7 days)
SESSION_EXPIRE_MINUTES=10080

# Cookie SameSite policy:
# - Use 'lax' if frontend and backend share the same parent domain (e.g. app.domain.com and api.domain.com)
# - Use 'none' if frontend and backend are on completely separate domains (e.g. vercel.app and onrender.com)
SESSION_COOKIE_SAMESITE=lax


# ------------------------------------------------------------------------------
# 4. CORS & ORIGIN SETTINGS
# ------------------------------------------------------------------------------
# The canonical URL of the deployed Next.js frontend application (no trailing slash)
FRONTEND_ORIGIN=http://localhost:3000

# Comma-separated list of allowed origins for CORS headers
# Example for production: https://gradient-ai.vercel.app,https://yourcustomdomain.com
CORS_ORIGINS=http://localhost:3000


# ------------------------------------------------------------------------------
# 5. GOOGLE IDENTITY SERVICES (OAuth 2.0)
# ------------------------------------------------------------------------------
# Create OAuth 2.0 Web Client credentials in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
#
# Authorized JavaScript Origins:
#   - http://localhost:3000 (Development)
#   - https://your-app.vercel.app (Production)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret


# ------------------------------------------------------------------------------
# 6. ML & ASSET DIRECTORIES
# ------------------------------------------------------------------------------
# Path to directory containing the 4 joblib model artifacts
MODEL_DIR=../ml/models

# Output directory for server-generated PDF dossiers
PDF_OUTPUT_DIR=reports/generated


# ------------------------------------------------------------------------------
# 7. FRONTEND PUBLIC ENVIRONMENT VARIABLES (Next.js)
# ------------------------------------------------------------------------------
# Base API URL used by the client-side Next.js application
# Local development: http://localhost:8000/api/v1
# Production: https://your-backend-service.onrender.com/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Public Google OAuth Client ID (must match GOOGLE_CLIENT_ID above)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

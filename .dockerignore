.git
.gitignore

# Local secrets and environment files
.env
.env.*
!.env.example
frontend/.env*
backend/.env*

# Python local artifacts
**/__pycache__/
**/*.py[cod]
backend/.venv/
backend/venv/
.pytest_cache/
.ruff_cache/

# Node local artifacts
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/coverage/

# Generated/runtime artifacts
backend/reports/generated/
reports/generated/
*.sqlite
*.sqlite3
*.db

# Editor/OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db

